#       type: "password"
#       password_env: "A100_SSH_PASSWORD"
#     disk_mounts: ["/", "/data"]      # 容量监控目录（可在网页设置里逐台修改）
#     allow_user_write: false          # 允许在这台主机执行账号写操作（默认关闭）
#     disk_health:
#       enabled: true
#
#   - name: "l40s-01"
#     host: "10.0.0.22"
#     port: 22
#     username: "ops"
#     group: "GPU 集群"
#     owner: "李四"
#     location: "机房 B"
#     tags:
#       - "gpu"
#       - "l40s"
#     auth:
#       type: "password"
#       password_env: "L40S_01_SSH_PASSWORD"
