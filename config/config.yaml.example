# ============================================================================
# 服务器轮询监测工具 —— Windows PC 桌面客户端示例配置（v1.4，纯单机）
# Server Polling Monitor —— Windows PC (PyInstaller onedir) example config
#
# 用法：复制本文件为 config/config.yaml，复制 config/.env.example 为
#       config/.env（可选），填写真实值后双击 启动.bat。
#       （旧版 Docker 部署请继续使用仓库根目录的 config.yaml.example）
#
# 说明：所有形如 *_env 的字段都写“环境变量名”，真实密码放在 config/.env 中，
#       不要把明文密码写进本文件。config/.env 是**可选**的：不建也能启动，
#       首次打开网页会跳到 /setup 设置管理员密码，之后在「设置」页维护密码。
#
#       本文件只是“首次启动的种子配置”。1.1 起，主机、SSH 凭据、通知、
#       报告启停、磁盘容量目录等都可在浏览器「设置」页修改并保存到 SQLite；
#       敏感值使用当前 Windows 账户的 DPAPI 加密，换电脑后需重新设置。
#
#       v1.2 起支持网页配置；v1.4 起为纯单机桌面客户端：
#       - 主机批量导入（设置页粘贴 YAML/CSV，先预览再导入）
#       - 告警静默（全局/按主机/按时段，静默期内不重复打扰）
#       - 主机分组 / 负责人 / 位置，概览页可按分组、状态、关键字筛选
#       - 系统托盘（打开看板 / 打开日志目录 / 退出）
#       - 端口被占用时自动顺延（auto_port_fallback）
#       - 日志入口：logs/servermonitor.log，托盘菜单可直接打开日志目录
# ============================================================================

# ---------------------------------------------------------------------------
# app：服务运行参数（轮询节奏）
# ---------------------------------------------------------------------------
app:
  poll_interval_seconds: 600          # 系统指标轮询间隔（秒）= 10 分钟
  disk_poll_interval_seconds: 86400   # 磁盘健康轮询间隔（秒）= 24 小时
  concurrency: 8                      # 并发 SSH 采集线程数
  retention_days: 90                  # 采样数据保留天数
  timezone: "Asia/Shanghai"
  auto_port_fallback: true            # 端口被占用时在 8080..8099 内自动顺延
  tray_enabled: true                  # 显示系统托盘图标（Windows）
  open_browser_on_start: true         # 启动后自动打开看板
  # 使用模式：admin = 管理员看全部功能；user = 实验室成员只看自己账号所在服务器
  # user 模式必须同时填写 member_account（自己在服务器上的 Linux 账号名）
  mode: "admin"
  member_account: ""

# ---------------------------------------------------------------------------
# dashboard：本地 Web 看板
# ---------------------------------------------------------------------------
dashboard:
  host: "127.0.0.1"
  port: 8080
  session_lifetime_hours: 12
  session_secret_env: "DASHBOARD_SECRET"
  auth:
    enabled: true
    username: "admin"
    password_env: "DASHBOARD_PASSWORD"

# ---------------------------------------------------------------------------
# alerts：告警策略与阈值
# ---------------------------------------------------------------------------
alerts:
  enabled: true
  desktop_notification: true          # Windows 桌面通知（winotify）
  email: true
  cooldown_minutes: 60
  repeat_while_active: false
  offline_failures: 2                 # 连续失败 N 次判定离线
  consecutive_periods: 2              # 连续异常周期数（1..10），减少瞬时抖动误报
  webhook:
    enabled: false                    # 需要企业微信/钉钉/飞书推送时改为 true
    type: "wecom"                     # wecom / dingtalk / feishu / generic
    url_env: "ALERT_WEBHOOK_URL"
  thresholds:
    cpu_percent: 90
    memory_percent: 90
    disk_percent: 90
    gpu_memory_percent: 90
    disk_temperature_c: 55            # 硬盘温度告警阈值（摄氏度）

# ---------------------------------------------------------------------------
# disk_health：磁盘/SMART 健康检查（需要目标机安装 storcli 时按需开启）
# ---------------------------------------------------------------------------
disk_health:
  enabled: true
  use_sudo: true
  storcli_candidates:
    - "storcli"
    - "storcli64"
    - "/opt/MegaRAID/storcli/storcli64"
    - "/opt/lsi/storcli/storcli64"
    - "/usr/local/bin/storcli"
    - "/usr/sbin/storcli"
  rules:
    alert_on_media_errors: true
    alert_on_other_errors: true
    alert_on_predictive_failure: true
    alert_on_smart_flag: true
    alert_on_state_not_optimal: true
    alert_on_error_increase: true

# ---------------------------------------------------------------------------
# smtp：日报邮件发送（不需要邮件时保持示例值即可；网页「设置 → 通知」可随时配置）
# ---------------------------------------------------------------------------
smtp:
  host: "smtp.example.com"
  port: 465
  username: "monitor@example.com"
  password_env: "SMTP_PASSWORD"
  use_ssl: true
  from_addr: "monitor@example.com"
  to_addrs:
    - "ops@example.com"

# ---------------------------------------------------------------------------
# ssh：SSH 连接/命令超时（秒）
# ---------------------------------------------------------------------------
ssh:
  connect_timeout: 10
  command_timeout: 20

# ---------------------------------------------------------------------------
# report：日报 / 周报 / 领导摘要
# ---------------------------------------------------------------------------
report:
  subject_prefix: "[Server Daily Report]"
  include_failed_hosts: true
  daily_enabled: false
  daily_time: "09:00"
  executive:
    enabled: false
    subject_prefix: "[Leader Summary]"
    to_addrs:
      - "leader@example.com"
  weekly:
    enabled: false
    subject_prefix: "[Server Weekly Report]"
    busy_threshold: 70.0
    idle_threshold: 20.0
    time: "16:00"

# ---------------------------------------------------------------------------
# storage：本地 SQLite 数据（绿色包建议放在 data/ 下）
# ---------------------------------------------------------------------------
storage:
  enabled: true
  db_path: "data/servermonitor.db"

# ---------------------------------------------------------------------------
# user_monitoring：服务器用户只读监控（v0.3.0）
#
# 每小时读取每台主机的 /etc/passwd 与 /etc/group，只统计 UID >= 1000 的普通账号，
# 系统账号（root、daemon、sshd 等）不采集、不展示、不告警。
# 每 6 小时用 du 统计 /home/<用户名> 与 /data/<用户名> 的占用（需要 sudo 时使用主机
# 已配置的 sudo 密码，未配置则回退 sudo -n；无权限只影响占用显示）。
# 全程只读：不会创建账号、修改密码或目录权限。
# 单台主机可在网页设置里用 user_monitoring: false 关闭。
#
# v0.5.0 起可选的账号写操作（新建账号 / 重置密码 / 加 docker 组 / 建 data 目录）：
# write_enabled 是总开关，默认 false；即使打开，每台主机还要单独 allow_user_write:
# true 且已保存 sudo 密码，并在页面上预览计划、手输主机名+账号名确认后才会执行。
# 密码只经 SSH 标准输入传递，不进命令行、日志或数据库；每次操作写入审计表。
# ---------------------------------------------------------------------------
user_monitoring:
  enabled: true
  scan_interval_seconds: 3600         # 账号/组/目录扫描间隔（300..86400）
  usage_interval_seconds: 172800      # 目录占用统计间隔（3600..604800，默认两天）
  # du 大目录很慢：占用统计单独给足超时（秒），默认 1800
  usage_timeout_seconds: 1800
  command_timeout: 120                # 单条远端命令超时秒数（10..600）
  write_enabled: false                # 账号写操作总开关（默认关闭）

# ---------------------------------------------------------------------------
# servers：被监测的 Linux 服务器
#
# v1.2 起首次安装可以留空（servers: []）：启动后浏览器自动跳到 /setup，
# 设置管理员密码 → 登录 → 「设置」页添加主机，或使用「导入」粘贴 YAML/CSV
# 批量导入（先预览再确认）。主机可带 group / owner / location 元数据。
#
# 如需在配置文件里预置，可取消下面示例的注释并填写（示例统一用密码认证，
# 避免依赖私钥文件）。disk_mounts 为容量监控目录，默认 ["/", "/data"]。
# ---------------------------------------------------------------------------
servers: []

# servers:
#   - name: "a100"
#     host: "10.0.0.21"
#     port: 22
#     username: "root"
#     group: "GPU 集群"
