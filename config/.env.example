# ============================================================================
# 服务器轮询监测工具 —— Windows PC 绿色包环境变量示例（v1.2）
# 本文件是**可选**的：复制为 config/.env 后再把占位值改成真实值。
# 变量名必须与 config/config.yaml 里的 *_env 字段一一对应。
#
# 1.1 起，本文件只用于“首次启动迁移”：程序第一次运行时会把这些明文值
# 加密迁入 data/servermonitor.db 的 app_secrets（DPAPI，仅当前 Windows 账户
# 可解密）。之后请在浏览器「设置」页修改，密码/密钥不会再回显。
#
# 1.2 起首次安装可以完全不建 config/.env：直接双击 启动.bat，浏览器会跳到
# /setup 设置管理员密码，再在「设置」页填写 SMTP / SSH / Webhook 等凭据。
# 因此下面所有变量都是可选的，只有你确实想用 .env 预置时才需要复制本文件。
# ============================================================================

# --- Web 看板 ---
# 看板登录密码（dashboard.auth.password_env = DASHBOARD_PASSWORD）
# 不填也可以：首次 /setup 会在浏览器里设置管理员密码并加密入库。
DASHBOARD_PASSWORD="replace_with_dashboard_password"
# 会话签名密钥，建议填一串随机字符（dashboard.session_secret_env = DASHBOARD_SECRET）
DASHBOARD_SECRET="replace_with_a_long_random_string"

# --- SMTP 邮件 ---
# 邮箱 SMTP 授权码 / 密码（smtp.password_env = SMTP_PASSWORD）
SMTP_PASSWORD="replace_with_smtp_app_password"

# --- 告警 Webhook（alerts.webhook.url_env = ALERT_WEBHOOK_URL）---
ALERT_WEBHOOK_URL=""

# --- 被监测服务器 SSH 密码（可选，示例；与 servers[].auth.password_env 对应）---
# config.yaml.example 默认 servers: []，主机与凭据可在网页「设置」页或
# 「导入」中维护，因此下面两行默认注释掉，需要预置时再取消注释。
# A100_SSH_PASSWORD="replace_with_a100_ssh_password"
# L40S_01_SSH_PASSWORD="replace_with_l40s_01_ssh_password"
