# Python caches
__pycache__/
*.py[cod]
*.pyo

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Node dependencies (root + backend workspace)
node_modules/

# Build artifacts
build/
dist/
*.egg-info/

# Desktop build outputs
desktop/node_modules/
desktop/release-electron/
desktop/build/portable/
release/
.tmp/
.superpowers/
samples/

# Virtual environments
.venv/
venv/
env/

# Local runtime files
logs/
*.log
data/*
!data/.gitkeep

# Archived copies, offline backups and one-off scratch dirs
# (an untracked servermonitor-main/ copy once confused the packaging script root detection)
servermonitor-main/
backup_*/
.tmp-upd/

# Local configuration and secrets
.env
config.yaml
ssh/

# IDE and OS files
.DS_Store
.idea/
.vscode/
