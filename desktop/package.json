{
  "name": "server-monitor-desktop",
  "version": "0.2.12",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build-main.mjs && electron-builder --win",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "build:main": "node scripts/build-main.mjs",
    "start:scaffold": "node scripts/build-main.mjs && electron dist/main.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.20.5",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
